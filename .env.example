# Database (MySQL on VPS, accessed via hostNetwork)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tomanotas
DB_USER=root
DB_PASSWORD=

# Firebase Cloud Messaging
# Path inside the container where the service account JSON is mounted
# (from the fcm-credentials Secret).
GOOGLE_APPLICATION_CREDENTIALS=/secrets/firebase-sa.json

# Optional: pin the timezone (default America/Bogota)
APP_TIMEZONE=America/Bogota
